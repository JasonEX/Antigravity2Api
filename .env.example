# App config
AG2API_HOST=0.0.0.0
AG2API_PORT=3000
AG2API_API_KEYS=sk-your-secret-key-1,sk-your-secret-key-2
AG2API_PROXY_ENABLED=false
AG2API_PROXY_URL=
AG2API_DEBUG=false
AG2API_LOG_RETENTION_DAYS=3
# Optional: Fixed retry delay (ms) used for network errors / 429 without retryDelay / post-rotation cooldown
AG2API_RETRY_DELAY_MS=1200
# Optional: Quota refresh interval (seconds). Each tick refreshes ALL accounts concurrently.
AG2API_QUOTA_REFRESH_S=300

# Optional: override Antigravity version used to build the default User-Agent
# - Example: 1.15.8
# - Only takes effect when AG2API_ANTIGRAVITY_USER_AGENT is empty.
AG2API_ANTIGRAVITY_VERSION=

# Optional: override upstream Antigravity User-Agent used for Google v1internal requests
# - Must include version (e.g. antigravity/1.15.8 linux/amd64), otherwise upstream may reject the request.
# - Alias: AG2API_USER_AGENT
AG2API_ANTIGRAVITY_USER_AGENT=

# Optional: Claude model mapping (Claude API incoming model -> upstream model)
# - JSON object only (supports multiple mappings):
#   AG2API_CLAUDE_MODEL_MAP={"claude-haiku-4-5-20251001":"gemini-3-flash","claude-opus-4-5":"claude-opus-4-5-thinking"}
AG2API_CLAUDE_MODEL_MAP={"claude-haiku-4-5":"gemini-3-flash","claude-haiku-4-5-20251001":"gemini-3-flash"}

# Optional: Gemini model mapping (Gemini API incoming model -> upstream model)
# - JSON object only (supports multiple mappings):
#   AG2API_GEMINI_MODEL_MAP={"gemini-3-flash-preview":"gemini-3-flash","gemini-3-pro-preview":"gemini-3-pro-high"}
AG2API_GEMINI_MODEL_MAP=

# Optional (Recommended): MCP 工具 XML 方案（仅 mcp__*）
# - false => 保持原始行为
# - true  => 上游不透传 mcp__* tools，改为提示模型输出 XML，再由代理转换回 tool_use/tool_result
AG2API_MCP_XML_ENABLED=true

# Deprecated/已弃用: old MCP switching (Claude ↔ Gemini reroute + retry)
# - Unset / empty => MCP switching disabled
# - Set to a Gemini model name => enable (not recommended; may be removed)
# AG2API_SWITCH_TO_MCP_MODEL=gemini-3-flash

# Optional: Thought Signatures / multi-instance
# - In multi-instance (no sticky sessions), set a shared JSONL path so instances can replay tool_use thoughtSignatures.
# - Path can be absolute, or relative to the process working directory (Docker: /app).
AG2API_THOUGHT_SIGNATURE_STORE_PATH=
# Optional: If the current turn's first tool_use signature is missing and can't be restored, inject a dummy signature.
# - Set to true/1 to use: skip_thought_signature_validator
# - Or set to a custom string.
AG2API_THOUGHT_SIGNATURE_DUMMY=
AG2API_THOUGHT_SIGNATURE_CACHE_MAX=50000

# Optional: Admin UI update check (GitHub latest release)
# - Defaults to znlsl/Antigravity2Api
AG2API_UPDATE_REPO=JasonEX/Antigravity2Api

# Optional: override OAuth client (otherwise uses built-in defaults)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
